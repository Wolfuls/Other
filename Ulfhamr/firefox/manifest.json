{
  "manifest_version": 3,
  "name": "情報拡張装置【ウールヴハム】",
  "version": "1.0.5",
  "description": "ユグドラシルRWのセッションを補助します。",
  "browser_specific_settings": {
    "gecko": {
      "id": "{24d022aa-b1a9-4203-9d77-f65b45e5119f}",
      "strict_min_version": "115.0"
    }
  },
  "sidebar_action": {
    "default_title": "ウールヴハム",
    "default_panel": "index.html",
    "default_icon": "Ulfhamr.svg",
    "open_at_install": true
  },
  "action": {
    "default_title": "ウールヴハムを開く",
    "default_icon": "Ulfhamr.svg"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "icons": {
    "48": "Ulfhamr.svg",
    "96": "Ulfhamr.svg"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://udonarium-lycoris.ddns.net/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://udonarium-lycoris.ddns.net/*"
      ],
      "js": [
        "lycoris-content.js",
        "lycoris-token-bridge.js",
        "lycoris-chat-content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "homepage_url": "https://wolfuls.github.io/Other/Ulfhamr/"
}
