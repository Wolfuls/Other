@media(min-width:1100px){
 .wrap{max-width:1920px}
 .layout{display:grid;grid-template-columns:minmax(220px,.65fr) clamp(350px,calc((100dvh - 155px)*.7324),640px) minmax(250px,.65fr);gap:14px;max-width:none}
 .monitor-panel{display:block;position:sticky;top:12px}
 .cabinet{width:100%;min-width:0}
}

@media(min-width:1100px){.monitor-panel{max-width:420px;width:100%;justify-self:end}}

/* v0.34: play surface first, settings behind a tab. */
.panel{display:flex;flex-direction:column;align-self:stretch;max-height:none;overflow:visible;padding:0;min-height:0;gap:10px}
.panel-tabs{display:flex;gap:4px;border-bottom:1px solid #314558;padding-bottom:6px}
.panel-tabs button{flex:1;border:0;border-radius:7px;background:transparent;color:#8ba6b9;padding:9px}
.panel-tabs button[aria-selected="true"]{background:#253b4d;color:#f5ddb0}
.panel-content{position:relative;flex:1;min-height:0}
#optionsPane{position:absolute;inset:0;overflow:auto;padding-right:4px}
#optionsPane:not([hidden]){display:grid;align-content:start;gap:9px}
[hidden]{display:none!important}
.panel>.cabctrl{position:static;margin-top:auto;padding:12px}
.handle-row{flex-direction:column-reverse;justify-content:center;gap:10px;padding:16px 0 4px}
.handle-notes{text-align:center}.handle-notes p{margin:0;font-size:11px}
.playfield .lcd{display:flex;flex-direction:column;justify-content:center;gap:2cqw}
.playfield .lcd .hudtop{position:absolute;right:1cqw;top:1cqw;padding:0}
.playfield .lcd .mode-pill:not(.rushing){display:none}
.playfield .lcd .action{min-height:3.5cqw;margin:0;text-align:center}
.playfield .lcd .action .one{font-size:3.5cqw}
.playfield .lcd .reels{margin:0 1cqw}
.playfield .lcd .holds{padding:1cqw 0}
.marquee{padding-top:12px;padding-bottom:12px}
@media(max-width:1099px){.panel{min-height:300px}.panel-content:has(#optionsPane:not([hidden])){min-height:340px}.panel>.cabctrl{align-self:stretch}}

/* v0.35: reserve cabinet width; spend spare width on the centered monitor. */
#playPane{position:absolute;inset:0;overflow:auto;padding-right:4px}
#playPane:not([hidden]){display:grid;align-content:start;gap:9px}
@media(min-width:1100px){
 .layout{grid-template-columns:minmax(220px,1fr) clamp(350px,calc((100dvh - 155px)*.7324),640px) minmax(280px,.65fr)}
 .monitor-panel{max-width:560px;align-self:center;position:relative;top:auto}
}
@media(max-width:1099px){.panel-content{min-height:340px}}

/* Fixed action slot: text changes cannot displace symbols. */
.playfield .lcd .action{height:5cqw;min-height:5cqw;max-height:5cqw;flex:0 0 5cqw;overflow:hidden}
.playfield .lcd .action .one{line-height:5cqw;white-space:nowrap}
.reel.spinning{transform:none}
/* Dark pixel city; stage tint remains behind the translucent backdrop. */
.lcd .skyline{inset:0;clip-path:none;opacity:.85;background:url('../images/backgrounds/city-v37.png') center/cover no-repeat;image-rendering:pixelated}
.lcd:after{display:none}

/* Low-amplitude background motion; symbols and holds remain stationary. */
.lcd .skyline{transform:scale(1.05);animation:city-drift 26s ease-in-out infinite alternate}
.skyline:before{content:"";position:absolute;inset:-10%;background:linear-gradient(115deg,transparent 20%,#8cbce51c 43%,transparent 66%);animation:city-haze 18s ease-in-out infinite alternate}

@keyframes city-drift{from{transform:scale(1.05) translate(-.7%,0)}to{transform:scale(1.05) translate(.7%,-.5%)}}
@keyframes city-haze{from{transform:translateX(-8%);opacity:.3}to{transform:translateX(8%);opacity:.75}}

.volume-control{display:flex;align-items:center;gap:12px;margin:12px 0;color:#aec2cf;font-size:12px}
.volume-control input{min-width:0;flex:1;accent-color:#e7c278}
@media(prefers-reduced-motion:reduce){.lcd .skyline,.skyline:before{animation:none}}

.playfield .lcd .reel img.reel-digit{image-rendering:auto}
.reel img.number-only{inset:8%;width:84%;height:84%;object-fit:contain;image-rendering:auto}

/* Four hand-drawn cells in a 2x2 sheet. No image scaling animation. */
.reel img.character-art{width:200%;height:200%;max-width:none;object-fit:fill;inset:auto;left:0;top:0;transform:none;animation:character-frames 3.2s steps(1,end) infinite;animation-delay:var(--breath-delay,0s)}
@keyframes character-frames{
 0%,100%{left:0;top:0}
 25%{left:-100%;top:0}
 50%{left:0;top:-100%}
 75%{left:-100%;top:-100%}
}
.reel.spinning img.character-art{animation:none;left:0;top:0}
@media(prefers-reduced-motion:reduce){.reel img.character-art{animation:none;left:0;top:0}}

/* Arrival cue: dim the city, sweep red power through it, retain the marked die. */
.prealert-scene{position:absolute;inset:0;z-index:2;pointer-events:none;overflow:hidden}
.city-blackout,.city-power{position:absolute;inset:0;opacity:0}
.prealert-scene.active .city-blackout{animation:city-blackout .8s linear both}
.city-power{background:linear-gradient(0deg,#eb173b35,transparent 65%)}
.city-power:before,.city-power:after{content:'';position:absolute;left:-8%;width:116%;height:1.2%;background:#ff4e60;box-shadow:0 0 10px 3px #ff244d;transform:rotate(-8deg)}
.city-power:before{bottom:24%}.city-power:after{bottom:58%;transform:rotate(9deg)}
.prealert-scene.active .city-power{animation:city-power .8s ease-out both}
@keyframes city-blackout{0%{opacity:0}10%,26%{opacity:.94}40%{opacity:.55}100%{opacity:0}}
@keyframes city-power{0%,25%{opacity:0;clip-path:inset(0 100% 0 0)}36%{opacity:1}65%{opacity:.85;clip-path:inset(0 0 0 0)}100%{opacity:0;clip-path:inset(0 0 0 0)}}
.playfield .lcd .hold.suggest{filter:drop-shadow(0 0 3px #ff3152)}
.playfield .lcd .hold.active{animation:die-arrival .8s ease-out both}
@keyframes die-arrival{0%,100%{transform:translateY(0) rotate(0)}25%{transform:translateY(-65%) rotate(-12deg)}50%{transform:translateY(0) rotate(8deg)}70%{transform:translateY(-18%) rotate(-4deg)}}
@media(prefers-reduced-motion:reduce){.prealert-scene.active .city-blackout{animation:none;opacity:.3}.prealert-scene.active .city-power{animation:none;opacity:.25}.playfield .lcd .hold.active{animation:none}}

.info-row:has(#demoRecovery){flex-wrap:wrap;gap:8px}

/* Explicit image layers: character -> cut-in -> fixed number. */
.playfield .lcd .reel img.reel-digit{z-index:9}
.playfield .lcd .reel img.cutin-art{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:5;animation:none;opacity:1;transition:opacity .4s ease-out;pointer-events:none}
.reel.cutin-one img.character-art,.reel.cutin-two img.character-art{visibility:hidden}
.reel.cutin-fade img.character-art{visibility:visible}
.playfield .lcd .reel.cutin-fade img.cutin-art{opacity:0}


/* Eight painted raster frames: fast blade, then sparks only. */
.slash-overlay{position:absolute;z-index:20;pointer-events:none;overflow:visible;animation:slash-lifetime .68s linear both}
.slash-sprite{position:absolute;inset:0;background:url('../images/effects/slash-sheet-v63.png') 0 0/400% 200% no-repeat;animation:slash-frames .68s steps(1,end) both}
@keyframes slash-frames{0%{background-position:0 0}5%{background-position:33.333333% 0}10%{background-position:66.666667% 0}16%{background-position:100% 0}25%{background-position:0 100%}43%{background-position:33.333333% 100%}64%{background-position:66.666667% 100%}83%,100%{background-position:100% 100%}}
@keyframes slash-lifetime{0%,65%{opacity:1}100%{opacity:0}}
@media(prefers-reduced-motion:reduce){.slash-sprite{animation:none;background-position:0 100%}}

.jackpot-scene{position:absolute;inset:0;z-index:25;overflow:hidden;pointer-events:none;background:radial-gradient(ellipse at center,#6d3308db,#060912ed 75%);opacity:1;transition:opacity .45s}
.jackpot-tree{position:absolute;width:100%;height:100%;inset:0;object-fit:contain;image-rendering:pixelated;opacity:0;transform:scale(.25);filter:drop-shadow(0 0 10px #ffb321);transition:transform .6s cubic-bezier(.12,.85,.2,1),opacity .2s}
.jackpot-scene.burst .jackpot-tree,.jackpot-scene.crown .jackpot-tree{opacity:1;transform:scale(1.02)}
.jackpot-title{position:absolute;left:0;right:0;top:42%;text-align:center;font-family:'Yu Mincho','MS Mincho',serif;font-weight:900;font-size:15cqw;letter-spacing:-.06em;white-space:nowrap;color:#fff1ad;-webkit-text-stroke:1px #522100;text-shadow:0 3px #8a3d09,0 5px #321600,0 0 18px #ffaf16;opacity:0;transform:scale(2.6);transition:transform .24s cubic-bezier(.2,.8,.3,1),opacity .15s}
.jackpot-scene.crown .jackpot-title{opacity:1;transform:scale(1)}
.jackpot-scene i{position:absolute;left:50%;top:50%;width:2%;height:5%;background:linear-gradient(45deg,#b56816,#fff4ba,#e0a028);opacity:0}
.jackpot-scene.burst i,.jackpot-scene.crown i{animation:jackpot-shards 2.7s var(--delay) ease-out both}
@keyframes jackpot-shards{0%{opacity:0;transform:rotate(var(--angle)) translateY(0)}10%{opacity:1}80%{opacity:.8}100%{opacity:0;transform:rotate(var(--angle)) translateY(var(--travel)) rotate(260deg)}}
.jackpot-scene.leaving{opacity:0}
.lcd.jackpot-running .reel.winner{animation:none;border-color:#fff1a2;box-shadow:0 0 10px #ffc745}
@media(prefers-reduced-motion:reduce){.jackpot-tree,.jackpot-title{transition:opacity .2s}.jackpot-scene i{animation:none!important}}
/* v68: continuous rainbow radiance, reflected across the physical pin field. */
.jackpot-scene{isolation:isolate;background:#08031b}
.jackpot-rainbow,.jackpot-rays{position:absolute;inset:-65%;opacity:0;transition:opacity .25s;pointer-events:none}
.jackpot-rainbow{background:conic-gradient(#ff1265,#ffb900,#faff50,#28ff9c,#03cfff,#6154ff,#ff20db,#ff1265);filter:saturate(1.6);animation:jackpot-orbit 3s linear infinite}
.jackpot-rays{background:repeating-conic-gradient(from 7deg,transparent 0deg 9deg,#fffbc6a0 10deg 12deg,transparent 13deg 20deg);mix-blend-mode:screen;animation:jackpot-orbit 12s linear infinite reverse}
.burst .jackpot-rainbow,.crown .jackpot-rainbow{opacity:.85}.burst .jackpot-rays,.crown .jackpot-rays{opacity:.75}
.jackpot-tree{z-index:1;filter:drop-shadow(0 0 6px #fff9d3) drop-shadow(0 0 22px #ffc521);}
.jackpot-scene .jackpot-title{z-index:3;top:39%;font-size:19cqw;letter-spacing:-.1em;line-height:1.2;color:#fff4a8;-webkit-text-stroke:2px #7e2300;text-shadow:0 2px #fff,0 5px #ff9800,0 9px #691600,0 12px #240811,0 0 12px #fff,0 0 30px #ffb600}
.jackpot-scene.crown .jackpot-title{animation:jackpot-slam .4s ease-out both}
.jackpot-scene i{z-index:4;width:1.6%;height:3.5%;box-shadow:0 0 5px #ffea68}
.jackpot-scene.burst i,.jackpot-scene.crown i{animation-duration:3.6s}
.jackpot-ring{position:absolute;inset:10%;border:3px solid #fff2b1;border-radius:50%;box-shadow:0 0 12px #fff,0 0 35px #ffdd36,inset 0 0 20px #fff3a4;opacity:0;z-index:2;pointer-events:none}
.burst .jackpot-ring,.crown .jackpot-ring{animation:jackpot-ring 1.9s ease-out both}.burst .jackpot-ring.second,.crown .jackpot-ring.second{animation-delay:.3s}
.jackpot-spill{position:absolute;inset:0;z-index:6;pointer-events:none;opacity:0;mix-blend-mode:screen;transition:opacity .45s;background:radial-gradient(ellipse at 46% 43%,#fff4b9b0 0%,#ff2d8580 33%,transparent 70%),conic-gradient(from 20deg at 46% 43%,#ff2e55a0,#ffd94d80,#41ffb780,#33cfff90,#9d4dff90,#ff2e55a0);filter:hue-rotate(0deg)}
.cabinet.jackpot-lit .jackpot-spill{opacity:.85;animation:jackpot-color 3s linear infinite}
.cabinet.jackpot-lit{box-shadow:0 0 25px #ffdb58,0 0 65px #f725ac80,0 0 110px #4cbfff50}
.cabinet.jackpot-lit:before,.cabinet.jackpot-lit:after{background:linear-gradient(#ff386e,#ffe15b,#69ffa9,#52d9ff,#ca59ff);filter:drop-shadow(0 0 12px #fff);animation:jackpot-color 3s linear infinite}
.cabinet.jackpot-fading .jackpot-spill{opacity:0}.cabinet{transition:box-shadow .45s}
.lcd.jackpot-running{box-shadow:0 0 14px #fff6c9,0 0 40px #ff47be,0 0 70px #22dfff!important}
@keyframes jackpot-orbit{to{transform:rotate(360deg)}}
@keyframes jackpot-color{to{filter:hue-rotate(360deg)}}
@keyframes jackpot-ring{0%{opacity:.9;transform:scale(.15)}100%{opacity:0;transform:scale(2.3)}}
@keyframes jackpot-slam{0%{transform:scale(1.65) rotate(-5deg)}45%{transform:scale(.95) rotate(2deg)}70%{transform:scale(1.05) rotate(-1deg)}100%{transform:scale(1)}}
@media(prefers-reduced-motion:reduce){.jackpot-rainbow,.jackpot-rays,.jackpot-ring,.jackpot-title,.cabinet.jackpot-lit .jackpot-spill,.cabinet.jackpot-lit:before,.cabinet.jackpot-lit:after{animation:none!important}.jackpot-scene.crown .jackpot-title{transform:scale(1)}}
